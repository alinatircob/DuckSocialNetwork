<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ducksocialnetworkm.controller.CardController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <Label text="Administrare Carduri si Membri" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <TableView fx:id="tableViewCarduri" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="columnId" text="ID Card" prefWidth="80.0" />
                        <TableColumn fx:id="columnNume" text="Nume Card" prefWidth="150.0" />
                        <TableColumn fx:id="columnTip" text="Tip" prefWidth="120.0" />
                        <TableColumn fx:id="columnPerformanta" text="Perf. Medie" prefWidth="100.0" />
                        <TableColumn fx:id="columnMembri" text="Membri (ID Rate)" prefWidth="350.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Separator />

                <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5; -fx-padding: 10; -fx-background-radius: 5;">
                    <children>
                        <Label text="Card Nou:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="textIdCard" promptText="ID Card" prefWidth="80.0"/>
                        <TextField fx:id="textNumeCard" promptText="Nume Card" prefWidth="150.0"/>
                        <ComboBox fx:id="comboTipCard" promptText="Tip Card" prefWidth="150.0"/>
                        <Button text="Adauga Card" onAction="#handleAddCard" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Sterge Card Selectat" onAction="#handleDeleteCard" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-cursor: hand;"/>
                    </children>
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: #e8f6f3; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #1abc9c; -fx-border-width: 0 0 0 3;">
                    <children>
                        <Label text="Gestionare Membri:" style="-fx-font-weight: bold; -fx-text-fill: #16a085;"/>
                        <TextField fx:id="textIdUser" promptText="ID User (Rata)" prefWidth="120.0"/>
                        <Button text="Adauga Rata in Card" onAction="#handleAdaugaUserLaCard" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand;"/>
                        <Button text="Sterge Rata din Card" onAction="#handleStergeUserDinCard" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-cursor: hand;"/>
                        <Label text="(Selecteaza un card din tabel inainte de a actiona)" style="-fx-font-style: italic; -fx-text-fill: grey; -fx-font-size: 11px;"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>