<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="0.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ducksocialnetworkm.controller.ChatController"
      stylesheets="@style.css"> <HBox style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0; -fx-padding: 10;">
    <Label fx:id="lblChatPartner" text="Chat Partner" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
</HBox>

    <ListView fx:id="listMessages" VBox.vgrow="ALWAYS" styleClass="list-view"/>

    <VBox style="-fx-background-color: white; -fx-padding: 10;">

        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblReply" text="Replying to..." visible="false" managed="false"
                   style="-fx-text-fill: #65676b; -fx-font-size: 12px; -fx-padding: 0 0 5 10;"/>
        </HBox>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <TextField fx:id="txtMessage" promptText="Scrie un mesaj..." HBox.hgrow="ALWAYS"
                       styleClass="message-input"/>

            <Button text="TRIMITE" onAction="#handleSend" defaultButton="true"
                    styleClass="send-button"/>
        </HBox>
    </VBox>
</VBox>